{
  "$schema": "focus-loop/design-tokens@1",
  "source": "canvas 1791071241-7cd3 · board B-Foundations",
  "color": {
    "light": {
      "bg": { "value": "#F6F3EE", "use": "Screen background" },
      "surface": { "value": "#FFFFFF", "use": "Sheets, cards, widgets, Live Activity" },
      "ink": { "value": "#141210", "use": "Primary text, primary button fill" },
      "ink-2": { "value": "#4A443C", "use": "Secondary text" },
      "muted": { "value": "#6B645B", "use": "Labels, metadata (>= 4.5:1 on bg)" },
      "faint": { "value": "#8A8175", "use": "Large text only (>= 24px), e.g. 'of 4', seconds" },
      "rule": { "value": "#DDD6CB", "use": "Hairlines, outlines" },
      "chip": { "value": "#ECE5DA", "use": "Segmented control track" },
      "track": { "value": "#E9DFD3", "use": "Elapsed part of the disc, pending focus segments" },
      "track-break": { "value": "#D3E3D8", "use": "Pending break segments" },
      "focus": { "value": "#D9480F", "use": "Disc, loop strip focus segments. Never for text" },
      "focus-text": { "value": "#B93C0A", "use": "Focus-coloured labels ('FOCUS 2 OF 4')" },
      "break": { "value": "#2F7D4F", "use": "Break segments, break buttons, success text" },
      "on-break": { "value": "#FFFFFF", "use": "Text on break fill" },
      "break-bg": { "value": "#2F7D4F", "use": "Full-screen Break background" },
      "on-primary": { "value": "#F6F3EE", "use": "Text on ink button" },
      "primary-accent": { "value": "#F0A27F", "use": "Duration inside the primary button" },
      "scrim": { "value": "rgba(20,18,16,0.45)", "use": "Behind sheets" }
    },
    "dark": {
      "bg": { "value": "#0B0A09", "use": "Screen background (near-OLED black)" },
      "surface": { "value": "#191715", "use": "Sheets, cards, widgets, Live Activity" },
      "ink": { "value": "#F2EEE8", "use": "Primary text, primary button fill" },
      "ink-2": { "value": "#C9C2B8", "use": "Secondary text" },
      "muted": { "value": "#9A9289", "use": "Labels, metadata" },
      "faint": { "value": "#7A7269", "use": "Large text only" },
      "rule": { "value": "#2C2926", "use": "Hairlines, outlines" },
      "chip": { "value": "#221F1C", "use": "Segmented control track" },
      "track": { "value": "#2A2420", "use": "Elapsed part of the disc" },
      "track-break": { "value": "#1C2A22", "use": "Pending break segments" },
      "focus": { "value": "#FF6A2B", "use": "Disc, loop strip focus segments" },
      "focus-text": { "value": "#FF8A5B", "use": "Focus-coloured labels" },
      "break": { "value": "#3FA66A", "use": "Break segments, break buttons" },
      "break-text": { "value": "#6CC892", "use": "Success text" },
      "on-break": { "value": "#0B0A09", "use": "Text on break fill (white fails 4.5:1)" },
      "break-bg": { "value": "#173D28", "use": "Full-screen Break background" },
      "on-primary": { "value": "#0B0A09", "use": "Text on light primary button" },
      "primary-accent": { "value": "#B93C0A", "use": "Duration inside the primary button" },
      "scrim": { "value": "rgba(0,0,0,0.6)", "use": "Behind sheets" }
    }
  },
  "font": {
    "ui": { "family": "Host Grotesk", "fallback": "system-ui, sans-serif", "features": ["tnum"] },
    "user-words": {
      "family": "Newsreader",
      "fallback": "Georgia, serif",
      "use": "Anything the user wrote: intentions, parked thoughts"
    }
  },
  "type": {
    "timer": {
      "size": 200,
      "weight": 600,
      "tracking": "-0.06em",
      "lineHeight": 0.85,
      "note": "Minutes; seconds at 56/500 in faint"
    },
    "timer-tablet": { "size": 300, "weight": 600, "tracking": "-0.06em" },
    "h1": { "size": 44, "weight": 600, "tracking": "-0.03em", "lineHeight": 1 },
    "h1-screen": { "size": 36, "weight": 600, "tracking": "-0.03em" },
    "title": { "size": 22, "weight": 600 },
    "body": { "size": 17, "weight": 400, "lineHeight": 1.5 },
    "label": { "size": 14, "weight": 600, "tracking": "0.05em", "case": "upper" },
    "caption": { "size": 13, "weight": 400 },
    "user-words": { "size": 26, "weight": 400, "lineHeight": 1.15, "font": "user-words" }
  },
  "dynamicType": { "scaleAll": true, "timerMaxScale": 1.3 },
  "space": {
    "unit": 4,
    "scale": [4, 8, 12, 16, 24, 32, 48],
    "screenPaddingPhone": 24,
    "screenPaddingTablet": 48
  },
  "radius": { "button": "pill (height / 2)", "card": 16, "sheet": 24, "widget": 26 },
  "size": { "touchTargetMin": 44, "buttonPrimary": 64, "buttonSecondary": 56, "listRow": 54 },
  "motion": {
    "disc": "Continuous linear shrink, 1 update per second",
    "discReducedMotion": "Update once per minute",
    "sheet": "Platform default sheet presentation",
    "haptic": "Light impact at end of focus and end of break"
  }
}
